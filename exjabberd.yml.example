###
###              exjabberd configuration file
###
### This file only lists listeners and modules that are actually
### implemented. Anything not implemented yet lives in the commented
### blocks below (it is NOT started, and the server logs a warning
### for any unknown module name).
###
### The parameters used in this configuration file are explained at
###       https://docs.ejabberd.im/admin/configuration
###       https://docs.nxmpps.im/admin/configuration
###
### The configuration file is written in YAML.
### *******************************************************
### *******           !!! WARNING !!!               *******
### *******     YAML IS INDENTATION SENSITIVE       *******
### ******* MAKE SURE YOU INDENT SECTIONS CORRECTLY *******
### *******************************************************
### Refer to http://en.wikipedia.org/wiki/YAML

hosts:
  - localhost

loglevel: info

## If you already have certificates, list them here
# certfiles:
#  - /etc/letsencrypt/live/domain.tld/fullchain.pem
#  - /etc/letsencrypt/live/domain.tld/privkey.pem

listen:
  -
    port: 5222
    ip: "::"
    module: exjabberd_c2s
    max_stanza_size: 262144
    shaper: c2s_shaper
    access: c2s
    # STARTTLS is offered on this port but optional. There is no
    # starttls_required option yet: PLAIN/SCRAM also work without TLS.
  -
    port: 5223
    ip: "::"
    module: exjabberd_c2s
    max_stanza_size: 262144
    shaper: c2s_shaper
    access: c2s
    tls: true
  -
    port: 5269
    ip: "::"
    module: exjabberd_s2s_in
    max_stanza_size: 262144
    shaper: s2s_shaper
  -
    port: 5280
    ip: "::"
    module: exjabberd_http
    # Serves the web admin (/admin), REST API (/api), BOSH
    # (/bosh, /http-bind), XMPP over WebSocket (/ws) and HTTP File
    # Upload (/upload). Plain HTTP only; put a reverse proxy with
    # TLS in front of it in production.
## NOT IMPLEMENTED (removed from the active listen list on purpose —
## the old file claimed these ports, but nothing ever listened on them):
##   5443  HTTPS: /admin, /api, /bosh, /captcha, /upload, /ws — the
##         HTTP stack listens on plain HTTP port 5280 instead (see
##         the exjabberd_http entry above); there is no TLS HTTP
##         listener yet, and no captcha endpoint.
##   5280  HTTP: /admin, /.well-known/acme-challenge — /admin exists
##         now; ACME challenge handling does not.
##   5478  STUN/TURN over UDP — not implemented.
##   1883  MQTT — not implemented.
    module: mod_mqtt
    backlog: 1000

s2s_use_starttls: optional

# Dialback secret (XEP-0220): shared by every server in this
# administrative domain; keys are HMAC-SHA256 over it. When absent,
# the server generates a random ephemeral secret at boot (logged as
# a warning). NEVER commit a production secret to version control.
# s2s_dialback_secret: "change-me-to-a-long-random-secret"

# Map a domain to a host/port without DNS (SRV _xmpp-server._tcp,
# then A/AAAA on 5269, is used otherwise).
# s2s_host_overrides:
#   example.com:
#     host: 127.0.0.1
#     port: 5269

## HTTP stack (admin web, BOSH, WebSocket, file upload, REST API).
## `api_token` is the REST API Bearer token; `upload_secret` signs
## upload URLs and admin session cookies. The values below are DEV
## placeholders — change them in production, and NEVER commit a
## production secret. When `upload_secret` is empty, the server
## generates a random ephemeral secret per boot (upload URLs then
## stop working after a restart). Admin login uses a real XMPP
## account listed in the `admin` ACL below — there is no separate
## admin password to configure here.
http:
  api_token: "dev-api-token-change-me"
  upload_secret: ""
  upload_dir: "priv/uploads"
  upload_max_size: 10485760
  upload_expiry_seconds: 3600
  upload_url_base: ""
  bosh_wait: 60
  bosh_inactivity: 60

acl:
  local:
    user_regexp: ""
  loopback:
    ip:
      - 127.0.0.0/8
      - ::1/128
  admin:
    user:
      - admin@localhost

access_rules:
  local:
    allow: local
  c2s:
    deny: blocked
    allow: all
  announce:
    allow: admin
  configure:
    allow: admin
  muc_create:
    allow: local
  pubsub_createnode:
    allow: local
  trusted_network:
    allow: loopback

api_permissions:
  "console commands":
    from: ejabberd_ctl
    who: all
    what: "*"
  "webadmin commands":
    from: exjabberd_web_admin
    who: admin
    what: "*"
  "adhoc commands":
    from: mod_adhoc_api
    who: admin
    what: "*"
  "http access":
    from: mod_http_api
    who:
      access:
        allow:
          - acl: loopback
          - acl: admin
      oauth:
        scope: "ejabberd:admin"
        access:
          allow:
            - acl: loopback
            - acl: admin
    what:
      - "*"
      - "!stop"
      - "!start"
  "public commands":
    who:
      ip: 127.0.0.1/8
    what:
      - status
      - connected_users_number

shaper:
  normal:
    rate: 3000
    burst_size: 20000
  fast: 100000

shaper_rules:
  max_user_sessions: 10
  max_user_offline_messages:
    5000: admin
    100: all
  c2s_shaper:
    none: admin
    normal: all
  s2s_shaper: fast

modules:
  mod_adhoc: {}
  mod_adhoc_api: {}
  mod_admin_extra: {}
  mod_announce:
    access: announce
  mod_avatar: {}
  mod_blocking: {}
  mod_bosh: {}
  mod_caps: {}
  mod_configure: {}
  mod_disco: {}
  mod_fail2ban: {}
  mod_http_api: {}
  # mod_http_upload serves XEP-0363 slots; the PUT/GET URLs are built
  # from http.upload_url_base (or the HTTP listener) by the HTTP stack.
  # Limits live in the `http:` section above.
  mod_http_upload: {}
  mod_last: {}
  mod_mam:
    ## Mnesia is limited to 2GB, better to use an SQL backend
    ## For small servers SQLite is a good fit and is very easy
    ## to configure. Uncomment this when you have SQL configured:
    ## db_type: sql
    assume_mam_usage: true
    default: always
  mod_mqtt: {}
  mod_muc:
    access:
      - allow
    access_admin:
      - allow: admin
    access_create: muc_create
    access_persistent: muc_create
    access_mam:
      - allow
    default_room_options:
      mam: true
  mod_muc_admin: {}
  mod_offline:
    access_max_user_messages: max_user_offline_messages
  mod_ping: {}
  mod_privacy: {}
  mod_private: {}
  mod_proxy65:
    access: local
    max_connections: 5
  mod_pubsub:
    access_createnode: pubsub_createnode
    plugins:
      - flat
      - pep
    force_node_config:
      ## Avoid buggy clients to make their bookmarks public
      storage:bookmarks:
        access_model: whitelist
  mod_push: {}
  mod_push_keepalive: {}
  mod_register:
    ## Only accept registration requests from the "trusted"
    ## network (see access_rules section above).
    ip_access: trusted_network
  mod_roster:
    versioning: true
  mod_s2s_bidi: {}
  mod_s2s_dialback: {}
  mod_shared_roster: {}
  mod_stun_disco: {}
  mod_vcard: {}
  mod_vcard_xupdate: {}
  mod_version:
    show_os: false

## NOT IMPLEMENTED YET (kept here as a record, not started):
##   mod_carboncopy    (XEP-0280 message carbons) — no implementation.
##   mod_client_state  (XEP-0352 client state indication) — no implementation.
##   mod_stream_mgmt   (XEP-0198 stream management) — no implementation.
## The server logs a warning and skips any module name it cannot resolve.

### Local Variables:
### mode: yaml
### End:
### vim: set filetype=yaml tabstop=8
